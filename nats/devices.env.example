# Copy to /opt/nats/devices.env on the central host (NOT tracked in git, so
# adding an edge needs no stack redeploy). host-init creates an empty one if
# the file is missing.
#
# Space-separated JetStream DOMAINS -- the `domain:` value from each edge's
# jetstream{} block, not its server_name. They happen to match today by
# convention, but the source address is $JS.<domain>.API, so the domain is what
# matters. Confirm a device's actual value with:
#   curl -s localhost:8222/varz | jq '.jetstream.config.domain'
#
# After editing:  docker compose run --rm nats-init

EDGE_DOMAINS=edge-nats-chris
